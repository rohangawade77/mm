/* ---------------- PERSISTENCE ---------------- */
const DB_KEY = "grc-db-v1", SESSION_KEY = "grc-session";
/* Data saved under the previous branding is migrated across on first load
   rather than discarded, so existing products and orders survive the rename. */
const LEGACY_DB_KEYS = ["azf-db-v3", "azf-db-v2", "azf-db-v1"];

function migrateBranding(db) {
  const swap = t => String(t ?? "")
    .replace(/AtoZ Fresh/g, "GROCERY")
    .replace(/atozfresh\.com/g, "grocery.com")
    .replace(/\bAZF-/g, "GRC-")
    .replace(/\bAZ-(\d{4})\b/g, "GR-$1");
  if (db.settings?.company) {
    db.settings.company.name = swap(db.settings.company.name);
    db.settings.company.email = swap(db.settings.company.email);
  }
  (db.products || []).forEach(p => { p.name = swap(p.name); p.brand = swap(p.brand); p.desc = swap(p.desc); });
  (db.vendors || []).forEach(v => { v.password = swap(v.password); });
  (db.orders || []).forEach(o => {
    o.id = swap(o.id);
    (o.lines || []).forEach(l => { l.name = swap(l.name); });
  });
  return db;
}

