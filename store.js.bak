    { id:"V-1004", name:"Sana Iqbal",  shop:"Fresh Corner Halal Mart", email:"sana@freshcorner.ie", phone:"+353 87 123 4567", status:"pending", tier:null, password:null, createdAt:"2026-07-30T10:12:00Z", approvedAt:null, notes:"", overrides:{}, address:"" },
